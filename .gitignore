# Rust build output.
/target
target/

# Generated per-platform npm packages and their copied binaries.
/npm/dist/
npm/dist/
# README.md and LICENSE are copied into the launcher package at publish time.
/npm/droidsight/README.md
/npm/droidsight/LICENSE
node_modules/

# Secrets and local environment. Never commit these. These rules are a first
# line of defense only; the staged secret scan in CI is the enforcement layer.
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
.npmrc
.pypirc
.netrc
.authinfo
credentials/
credentials.*
secrets/
secrets.*
tokens/
tokens.*
private/
personal/
confidential/
sensitive/
exports/
captures/
evidence/
artifacts/
reports/
*.secret
*.secrets
*.token
*.token.*
*.credentials
token.txt
tokens.txt
secret.txt
secrets.txt
credentials.txt
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.kdbx
*.asc
*.gpg
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.aws/
.azure/
.gcloud/
.kube/
.ssh/

# Local data exports and browser/network captures can contain personal text,
# cookies, authorization headers, or device identifiers.
*.sqlite
*.sqlite3
*.db
*.db-*
state.json
baseline.json
*.csv
*.tsv
*.jsonl
*.ndjson
*.har
*.pcap
*.pcapng
*.trace
*.dmp
*.etl

# Coding-agent and editor working directories. These routinely contain absolute
# local paths, transcripts, and machine names.
.agent/
.agents/
.claude/
.cursor/
.aider*
.instant-approve/
.vscode/
.idea/
*.code-workspace
*.swp
*~

# Device evidence. This server captures screenshots, UI hierarchies, logs, and
# crash reports; none of it belongs in version control. Add a targeted `!`
# exception below if documentation ever needs a committed image.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.mp4
*.webm
screenshots/
# UI hierarchy dumps carry on-screen text, so ignore them by name. A blanket
# *.xml would also swallow any XML a contributor legitimately adds.
window_dump*
ui_dump*
*.log
logs/
*.apk
*.aab

# Local build/test diagnostics and MCP runtime logs.
build_err*.txt
check_err.txt
test_output.txt
mcp_*.log
*.bak
*.exe
*.dll
*.so
*.dylib
*.tmp
*.temp
*.tgz
*.tar.gz

# Hardware-smoke transfer destination.
.droidsight_probe_pull

# Local scratch. Anything a contributor needs to keep out of a commit can live
# under one of these without editing this file.
scratch/
tmp/
temp/
local/
*.local
*.orig
*.rej
Thumbs.db
desktop.ini
.DS_Store
